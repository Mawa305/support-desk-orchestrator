    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || '';\n\nlet data;\ntry {\n  data = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (err) {\n  data = { category: 'general', confidence: 0, reason: 'Routing output could not be parsed.' };\n}\n\nconst allowed = ['billing', 'booking', 'technical', 'complaint', 'general'];\nconst category = allowed.includes(data.category) ? data.category : 'general';\nconst confidence = typeof data.confidence === 'number' ? data.confidence : 0;\n\nreturn [{\n  json: {\n    category,\n    confidence,\n    reason: data.reason || 'no reason given'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
