        "jsCode": "const raw = $input.first().json.output || '';\n\nlet data;\ntry {\n  data = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (err) {\n  data = { approved: false, reason: 'QA output could not be parsed.' };\n}\n\n// Find the draft from whichever specialist ran in this execution\nconst specialists = ['Billing Agent', 'Booking Agent', 'Technical Agent', 'General Agent'];\nlet draft = '';\nfor (const name of specialists) {\n  try {\n    const out = $(name).first().json.output;\n    if (out) { draft = out; break; }\n  } catch (err) {\n    // this specialist did not run in this execution\n  }\n}\n\nreturn [{\n  json: {\n    approved: String(data.approved).trim().toLowerCase() === 'true',\n    reason: data.reason || 'no reason given',\n    draft\n  }\n}];"
      },
